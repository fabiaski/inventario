RewriteEngine On

# ==========================================================
# PRODUCTOS
# ==========================================================

RewriteRule ^productos/?$ src/pages/productos/productos.php [L]

# Importar productos desde Excel
RewriteRule ^importarprodu/?$ src/pages/productos/importar.php [L]

RewriteRule ^productos/agregar/?$ src/pages/productos/agregar-produ.php [L]
RewriteRule ^productos/editar/([0-9]+)/?$ src/pages/productos/editar.php?id=$1 [L]


# ==========================================================
# COTIZACIONES
# ==========================================================

RewriteRule ^cotizaciones/?$ src/pages/cotizaciones/cotizacion.php [L]
RewriteRule ^cotizaciones-agregar/?$ src/pages/cotizaciones/agregar-coti.php [L]
RewriteRule ^cotizaciones/editar/([0-9]+)/?$ src/pages/cotizaciones/editar.php?id=$1 [L]
RewriteRule ^cotizaciones/ver/([0-9]+)/?$ src/pages/cotizaciones/ver.php?id=$1 [L]

RewriteRule ^cotizaciones/actualizar/?$ src/pages/cotizaciones/actualizar.php [L]

# ==========================================================
# FACTURACIÓN
# ==========================================================

RewriteRule ^facturacion/?$ src/pages/facturacion/facturacion.php [L]
RewriteRule ^facturacion-agregar/?$ src/pages/facturacion/agregar-fact.php [L]
RewriteRule ^facturacion/ver/([0-9]+)/?$ src/pages/facturacion/ver.php?id=$1 [L]
RewriteRule ^facturacion/editar/([0-9]+)/?$ src/pages/facturacion/editar.php?id=$1 [L]
RewriteRule ^facturacion/eliminar/?$ src/pages/facturacion/eliminar.php [L]
RewriteRule ^facturacion/agregar-factura/([0-9]+)/?$ src/pages/facturacion/agregar_factura.php?id=$1 [L]
RewriteRule ^facturacion/editar-factura/([0-9]+)/?$ src/pages/facturacion/editar_factura.php?id=$1 [L]
RewriteRule ^facturacion/actualizar-factura/?$ src/pages/facturacion/actualizar_factura.php [L]
RewriteRule ^facturacion/eliminar-factura/?$ src/pages/facturacion/eliminar_factura.php [L]
RewriteRule ^facturacion/guardar-factura/?$ src/pages/facturacion/guardar_factura.php [L]
RewriteRule ^facturacion/agregar-soporte/?$ src/pages/facturacion/agregar_soporte.php [L]
RewriteRule ^facturacion/eliminar-soporte/?$ src/pages/facturacion/eliminar_soporte.php [L]
RewriteRule ^guardar/?$ src/pages/facturacion/guardar.php [L]
RewriteRule ^facturacion/actualizar/?$ src/pages/facturacion/actualizar.php [L]
RewriteRule ^facturacion/editar-factura/([0-9]+)/?$ src/pages/facturacion/editar_factura.php?id=$1 [L]

# ==========================================================
# CALENDARIO
# ==========================================================

RewriteRule ^calendario/?$ src/pages/calendario/calendario.php [L]


# ==========================================================
# FAVORES
# ==========================================================

RewriteRule ^favores/?$ src/pages/favores/favores.php [L]
RewriteRule ^favores/agregar/?$ src/pages/favores/agregar.php [L]
RewriteRule ^favores/persona/ver/?$ src/pages/favores/ver.php [L]
RewriteRule ^favores/editar/?$ src/pages/favores/editar.php [L]
RewriteRule ^favores/movimiento/agregar/([0-9]+)/?$ src/pages/favores/agregar_movimiento.php?id=$1 [L]
RewriteRule ^favores/movimiento/editar/?$ src/pages/favores/editar_movimiento.php [L]
RewriteRule ^favores/movimiento/eliminar/?$ src/pages/favores/eliminar_movimiento.php [L]
RewriteRule ^favores/movimiento/pagar/?$ src/pages/favores/pagar_movimiento.php [L]
RewriteRule ^favores/pdf/([0-9]+)/?$ src/pages/favores/pdf.php?id=$1 [L]
RewriteRule ^favores/finalizar/?$ src/pages/favores/finalizar.php [L]
RewriteRule ^favores/eliminar/?$ src/pages/favores/eliminar.php [L]

RewriteRule ^favores/finalizados/?$ src/pages/favores/finalizados.php [L]

# ==========================================================
# PROCESOS
# ==========================================================

RewriteRule ^procesos/?$ src/pages/procesos/index.php [L]
RewriteRule ^procesos/ver/([0-9]+)/?$ src/pages/procesos/ver.php?id=$1 [L]
RewriteRule ^procesos/crear/?$ src/pages/procesos/crear.php [L]
RewriteRule ^procesos/finalizados/?$ src/pages/procesos/finalizados.php [L]


# ==========================================================
# REPORTES
# ==========================================================

RewriteRule ^reportes/?$ src/pages/reportes/cuatrimestres.php [L]
RewriteRule ^reportes/cuatrimestre/?$ src/pages/reportes/ver_cuatrimestre.php [L]
RewriteRule ^reportes/exportar_cuatrimestre\.php/?$ src/pages/reportes/exportar_cuatrimestre.php [L]

# ==========================================================
# SMMLV
# ==========================================================

RewriteRule ^smmlv/?$ src/pages/smmlv/smmlv.php [L]
RewriteRule ^smmlv/agregar/?$ src/pages/smmlv/agregar.php [L]
RewriteRule ^smmlv/editar/([0-9]+)/?$ src/pages/smmlv/editar.php?id=$1 [L]