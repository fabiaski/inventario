RewriteRule ^permisos/gestionar/([0-9]+)/?$ src/admin/permisos/gestionar.php?id=$1 [L]


# ==========================================================
# ACTIVIDAD
# ==========================================================
RewriteRule ^actividad/?$ src/admin/actividad/index.php [L]


# ==========================================================
# PERFIL
# ==========================================================

RewriteRule ^perfil/?$ src/pages/perfil/perfil.php [L]
