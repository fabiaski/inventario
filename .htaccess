RewriteRule ^evidencias/galeria/?$ src/pages/evidencias/galeria.php [L]
RewriteRule ^evidencias/guardar/?$ src/pages/evidencias/guardar.php [L]
RewriteRule ^evidencias/eliminar/?$ src/pages/evidencias/eliminar.php [L]

RewriteRule ^evidencias/descargar-zip/?$ src/pages/evidencias/descargar_zip.php [L]
