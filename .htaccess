RewriteRule ^smmlv/editar/([0-9]+)/?$ src/pages/smmlv/editar.php?id=$1 [L]




# ==========================================================
# LOGIN
# ==========================================================

RewriteRule ^login/?$ src/login/index.php [L]
RewriteRule ^login/ingresar/?$ src/login/ingresar.php [L]
RewriteRule ^login/cerrar/?$ src/login/cerrar.php [L]


# ==========================================================
# ADMIN
# ==========================================================
RewriteRule ^admin/?$ src/admin/index.php [L]


# ==========================================================
# USUARIOS
# ==========================================================
RewriteRule ^usuarios/?$ src/admin/usuarios/index.php [L]
RewriteRule ^usuarios/agregar/?$ src/admin/usuarios/agregar.php [L]
RewriteRule ^usuarios/guardar/?$ src/admin/usuarios/guardar.php [L]
RewriteRule ^usuarios/editar/([0-9]+)/?$ src/admin/usuarios/editar.php?id=$1 [L]
RewriteRule ^usuarios/actualizar/?$ src/admin/usuarios/actualizar.php [L]
RewriteRule ^usuarios/eliminar/?$ src/admin/usuarios/eliminar.php [L]



# ==========================================================
# PERMISOS
# ==========================================================
RewriteRule ^permisos/?$ src/admin/permisos/index.php [L]
